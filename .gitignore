# secrets — never commit; .env is also blocked by the PreToolUse hook
.env
*.key
*.pem

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# runtime artifacts
logs/

# client projects live locally only — never pushed to the remote
projects/

# ZCode plan-mode session artifacts (skills/, config.json and tasks/ stay tracked)
.zcode/plans/
